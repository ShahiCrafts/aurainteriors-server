# Aura Interiors server - canonical environment list (AR-32). Every key registered in config/appConfig.js appears here.
# Copy to .env (or use the committed .env.development / .env.production templates) and fill in real values; never commit real secrets.

PORT=3001
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/aura_interiors_db?replicaSet=rs0
MONGO_DB_NAME=aura_interiors_db
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=0
MONGO_CONNECT_RETRIES=5
JWT_SECRET=CHANGE_ME_generate_at_least_32_random_characters
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7
# Set to 0 only to relax JWT iss/aud enforcement (FA-18)
# JWT_REQUIRE_ISS_AUD=
# OTP_PEPPER=
# NEWSLETTER_TOKEN_SECRET=
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
BACKEND_URL=http://localhost:3001
# Extra CORS/socket origins, comma-separated (OA-1); FRONTEND_URL + ADMIN_URL are always included
# CORS_EXTRA_ORIGINS=
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
BREVO_API_KEY=your_brevo_api_key
BREVO_API_BASE_URL=https://api.brevo.com/v3
BREVO_TIMEOUT_MS=15000
EMAIL_FROM="Aura Interiors <noreply@yourdomain.com>"
# Public support address used in email footers (OA-1)
SUPPORT_EMAIL=support@yourdomain.com
# Brand logo used in email headers (OA-1 lead review item 3) - no hardcoded fallback
EMAIL_LOGO_URL=https://aurainteriors.com/aura-logo.png
EMAIL_MODE=direct
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_TIMEOUT_MS=30000
ESEWA_MERCHANT_ID=EPAYTEST
ESEWA_SECRET_KEY=your_esewa_secret_key
ESEWA_ENV=sandbox
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key
EMBEDDING_API_URL=https://integrate.api.nvidia.com/v1/embeddings
EMBEDDING_MODEL_NAME=nvidia/llama-3.2-nv-embed-qa-4
EMBEDDING_VECTOR_SIZE=2048
NVIDIA_API_KEY=your_nvidia_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
MISTRAL_API_KEY=your_mistral_api_key
GROQ_CHAT_MODEL=openai/gpt-oss-120b
MISTRAL_CHAT_MODEL=mistral-small-latest
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct
GROQ_BASE_URL=https://api.groq.com/openai/v1
MISTRAL_BASE_URL=https://api.mistral.ai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CHAT_TOOL_TIMEOUT_MS=1500
CHAT_MAX_TOKENS=700
CHAT_TEMPERATURE=0.2
CHAT_MAX_TOOL_ROUNDS=3
CHAT_MAX_CONCURRENT_TURNS=0
CHAT_LLM_STREAM_TIMEOUT_MS=120000
# Set to 1 to allow custom LLM base URLs in production (FA-83)
# CHAT_ALLOW_CUSTOM_LLM_BASE_URLS=
# CART_GET_READONLY=
# DOCUMENT_DELETE_HONEST_STATUS=
GUEST_SESSION_TTL_MODE=creation
# GUEST_SESSION_ALLOW_QUERY=
# GUEST_STOCK_RESERVATION=
GUEST_STOCK_RESERVATION_TTL_MINUTES=30
GUEST_COD_HOLD_RELEASE_HOURS=0
CATEGORY_SVG_POLICY=reencode
BLOG_SEARCH_MODE=regex
ANALYTICS_CACHE_TTL_MS=0
# UPLOAD_MAX_TOTAL_BYTES=
SOCKET_REVALIDATE_INTERVAL_MS=0
SOCKET_ADAPTER=none
RATE_LIMIT_STORE=memory
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_READ_MAX=900
RATE_LIMIT_WRITE_MAX=300
# NOTE: read with two different defaults today (900 read / 300 write) - see inventory in AUDIT_ARCH_TRACKER paste block
# RATE_LIMIT_ADMIN_MAX=
WORKER_MODE=inline
BROADCAST_MODE=inline
JOB_POLL_MS=1000
JOB_CONCURRENCY=5
JOB_VISIBILITY_MS=60000
JOB_BACKOFF_BASE_MS=5000
JOB_BACKOFF_CAP_MS=300000
INGEST_CONCURRENCY=2
# INGEST_MAX_CHUNKS_PER_JOB=
INGEST_STUCK_AFTER_MS=600000
INGEST_MAX_RECOVERIES=3
RAG_EMBEDDING_TIMEOUT_MS=250
RAG_QDRANT_TIMEOUT_MS=5000
# RETENTION_CHAT_MESSAGE_DAYS=
# RETENTION_NOTIFICATION_DAYS=
# RETENTION_BLOG_ENGAGEMENT_DAYS=
# RETENTION_CONTACT_DAYS=
SHUTDOWN_DRAIN_TIMEOUT_MS=10000
# TRUST_PROXY=
HEALTH_DETAIL_TOKEN=your_health_detail_token_at_least_16_chars
# RETURN_TOKEN_IN_BODY=
# SEED_DEMO_DATA=
SEED_CUSTOMER_PASSWORD=your_seed_customer_password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password
# ALLOW_DESTRUCTIVE_DEMO_SEED=
# KEEP_ALIVE_ENABLED=
# KEEPALIVE_ENABLED=
KEEP_ALIVE_INTERVAL=14
# Platform-provided by Render only; not app config - keep-alive middle fallback
# RENDER_EXTERNAL_URL=
